# Backend configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
# Use an absolute path. Never commit the service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/firebase-service-account.json
UPLOAD_DIR=./backend/uploads
CORS_ORIGIN=http://localhost:5173

# Agent configuration
GROQ_API_KEY=
GROQ_MODEL=groq/openai/gpt-oss-120b
LLM_MODE=mock

# Required only when running backend/seed.py.
# Use a strong demo-only password; never reuse a real password.
SEED_USER_PASSWORD=

# Frontend configuration (used by later tasks)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_API_URL=http://localhost:8000
VITE_USE_MOCKS=true
